@section Hero {
    @await Html.PartialAsync("~/Views/Shared/Partials/_HeroSection.cshtml")
}

<section class="logo-strip">
    <div class="logo-items">
        <img src="~/images/company-supports-logo-1-prime 1.png" alt="Logoipsum">
        <img src="~/images/company-supports-logo-2-prime 1.png" alt="Logoipsum">
        <img src="~/images/company-supports-logo-3-prime 1.png" alt="Logoipsum">
        <img src="~/images/company-supports-logo-4-prime 1.png" alt="Logoipsum">
        <img src="~/images/company-supports-logo-5-prime 1.png" alt="Logoipsum">
    </div>

    <h2>Modern Equipment</h2>
</section>

<section class="about-section">
    <div class="about-image">
        <img src="~/images/about-us-image.png" alt="About CoreFitness">
    </div>

    <div class="about-content">
        <span class="section-badge">About Us</span>

        <h2>Elevating Fitness Journey with Expert Guidance</h2>

        <p>
            We support every stage of your fitness journey with certified trainers,
            personalized programs proven methods designed to help you train safely,
            build strength.
        </p>

        <div class="mission-card">
            Our mission is to transform lives by combining expert guidance,
            powerful training programs, and a motivating community that helps
            you grow stronger every day.
        </div>
    </div>
</section>

<section class="program-section">
    <span class="section-badge">Our Programs</span>

    <h2>Professional training program <br> for stronger health</h2>

    <div class="program-grid">
        <img src="~/images/program-image-1 1.png"" alt="Battle rope training">
        <img src="~/images/program-image-2 1.png" alt="Gym equipment">
        <img src="~/images/program-image-3 1.png" alt="Weight training">
    </div>

    <p class="quote-text">
        Let's make something great work together.
        <a href="#">Get Free Quote</a>
    </p>
</section>

<section class="store-preview">
    <span class="section-badge">Our Store</span>

    <h2>High quality fitness products <br> built for results</h2>

    <div class="product-grid">
        <div class="product-card">
            <img src="~/images/product-1.png" alt="Dumbbell">
        </div>

        <div class="product-card">
            <img src="~/images/product-2.png" alt="Gym bag">
        </div>

        <div class="product-card">
            <img src="~/images/product-3.png" alt="Fitness tracker">
        </div>

        <div class="product-card">
            <img src="~/images/product-4.png" alt="Treadmill">
        </div>
    </div>

    <p class="quote-text">
        Let's make something great work together.
        <a href="#">Get Free Quote</a>
    </p>
</section>
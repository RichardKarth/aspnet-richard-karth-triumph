@model RegisterPasswordForm

@{
    ViewData["Title"] = "Set your password";
    ViewData["ShowHero"] = false;
}

<div class="auth-container">

    <div class="auth-text">
        <h1>Set Your Password</h1>
        <p>
            Set a strong password to protect your account. For security reasons, your password must be at least 8 characters long and include uppercase and lowercase letters, numbers, and special characters.
        </p>
    </div>

    <hr class="auth-divider">

    <form class="auth-form" asp-action="SetPassword" asp-controller="Authentication" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password">
            
            <span asp-validation-for="Password"></span>
            
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword">

            <span asp-validation-for="ConfirmPassword"></span>
           
        </div>

        <button type="submit" class="auth-button">
            <span></span>
            <span class="continue-text">Continue</span>
            <i class="fa-solid fa-chevron-right arrow"></i>
        </button>
    </form>

    <div class="terms-checkbox">
        <input class="checkbox" type="checkbox" id="terms">

        <label for="terms">
            Accept user terms and conditions
        </label>
    </div>

</div>


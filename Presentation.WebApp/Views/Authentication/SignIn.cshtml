@model SignInForm

@{
    
    ViewData["Title"] = "Sign in";
    ViewData["ShowHero"] = false;
}

<div class="auth-container">

    <div class="auth-text">
        <h1>Welcome Back!</h1>

        <p>
            Log in to continue your fitness journey with full access to your customized
            program, training history, and progress tracking. Stay consistent, monitor
            your development, and keep moving forward with the structure and support
            built into your account.
        </p>
    </div>

    <hr class="auth-divider">

    <div class="auth-links">

        <a href="#" class="auth-link">
            <img src="~/images/google.png" alt="Google">
        </a>

        <a href="#" class="auth-link">
            <img src="~/images/facebook.png" alt="Facebook">
        </a>

        <a href="#" class="auth-link">
            <img src="~/images/github.png" alt="GitHub">
        </a>

    </div>

    <div class="continue-divider">
        <span></span>
        <p>OR CONTINUE WITH</p>
        <span></span>
    </div>

    <form asp-action="SignIn" asp-controller="Authentication" method="post" class="auth-form" novalidate>

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>

        <div class="form-group">
            <div class="password-label">
                <label asp-for="Password"></label>
                <a href="#">Forgot your password?</a>
            </div>

            <input asp-for="Password"/>
            <span asp-validation-for="Password"></span>
        </div>

        <div class="form-group">
            <input asp-for="RememberMe"/>
            <label asp-for="RememberMe"/>
        </div>

        <button type="submit" class="auth-button">
            <span></span>
            <h3 class="continue-text">Continue</h3>
            <i class="fa-solid fa-chevron-right arrow"></i>
        </button>

        <div class="terms-checkbox">
            <input class="checkbox" type="checkbox" id="terms">

            <label for="terms">
                Accept user terms and conditions
            </label>
        </div>

        <div class="terms-checkbox">
            <input class="checkbox" type="checkbox" id="terms" asp-for="RememberMe">

            <label>
                Remember me?
            </label>
        </div>

        @if(ViewData["ErrorMessage"] != null)
        {
            <div class="error-message">
                @ViewData["ErrorMessage"]
            </div>
        } 
)


    </form>

</div>


}

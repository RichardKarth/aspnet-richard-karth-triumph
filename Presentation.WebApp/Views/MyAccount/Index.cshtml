@{
    ViewData["Title"] = "MyAccount";
    ViewData["ShowHero"] = false;
}

<div class="my-account-container">
    <h1>My Account</h1>

    <div class="account-content">

        <div class="account-menu">
            <img src="~/images/trainer-1 1.png" alt="Profile Picture">

            <div class="menu-box">
                <div class="menu-header">Menu Options</div>

                <button class="menu-link active" data-tab="about">
                    About Me <i class="fa-solid fa-chevron-right"></i>
                </button>

                <button class="menu-link" data-tab="membership">
                    My Membership <i class="fa-solid fa-chevron-right"></i>
                </button>

                <button class="menu-link" data-tab="bookings">
                    My Bookings <i class="fa-solid fa-chevron-right"></i>
                </button>

                <button class="menu-link" data-tab="signout">
                    Sign Out <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>

            <p class="remove-info">If you like to cancel your account click below</p>
            <a class="remove-account" href="#">Remove Account</a>
        </div>

        <div class="right-column">

            <div class="account-form-card tab-content active" id="about">
                <h2>About Me</h2>

                <form method="post" asp-controller="" asp-action="">
                    <div class="account-form-group">
                        <label>First Name</label>
                        <input type="text" placeholder="Enter First Name">
                    </div>

                    <div class="account-form-group">
                        <label>Last Name</label>
                        <input type="text" placeholder="Enter Last Name">
                    </div>

                    <div class="account-form-group">
                        <label>Email Address *</label>
                        <input type="text" placeholder="username@domain.com">
                    </div>

                    <div class="account-form-group">
                        <label>Phone Number</label>
                        <input type="text" placeholder="Enter Phone Number">
                    </div>

                    <hr>

                    <div class="account-form-group file-group">
                        <label>Profile Image</label>

                        <div class="file-input">
                            <input type="text" placeholder="Upload Profile Image">
                            <button type="button">Browse</button>
                        </div>
                    </div>

                    <button type="submit" class="save-button">
                        Save
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </form>
            </div>

            <div class="account-form-card tab-content" id="membership">
                <h2>My Membership</h2>

                <div class="info-box">
                    <h3>Premium Membership</h3>
                    <p>Status: Active</p>
                    <p>Expires: 2026-12-31</p>
                </div>
            </div>

            <div class="account-form-card tab-content" id="bookings">
                <h2>My Bookings</h2>

                <div class="booking-list">
                    <div class="booking-item">
                        <h3>Strength Training</h3>
                        <p>Date: 2026-01-10</p>
                        <p>Time: 18:00</p>
                    </div>

                    <div class="booking-item">
                        <h3>Yoga Class</h3>
                        <p>Date: 2026-01-14</p>
                        <p>Time: 17:30</p>
                    </div>
                </div>
            </div>

            <div class="account-form-card tab-content" id="signout">
                <h2>Sign Out</h2>
                <p>Are you sure you want to sign out?</p>

                <button class="save-button" type="button">
                    Sign Out
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>

            <div class="statistics-card" id="statistics">
                <h2>My Statistics</h2>

                <div class="stats-box">
                    <div class="stat-row">
                        <div>
                            <span>Check-In (last 30 days)</span>
                            <strong>25</strong>
                        </div>
                        <div class="progress"><span style="width:95%"></span></div>
                    </div>

                    <div class="stat-row">
                        <div>
                            <span>Weight Goal</span>
                            <strong>50%</strong>
                        </div>
                        <div class="progress"><span style="width:50%"></span></div>
                    </div>

                    <div class="stat-row">
                        <div>
                            <span>Current BMI</span>
                            <strong>27</strong>
                        </div>
                        <div class="progress"><span style="width:65%"></span></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const menuLinks = document.querySelectorAll(".menu-link");
        const tabContents = document.querySelectorAll(".tab-content");
        const statistics = document.getElementById("statistics");

        menuLinks.forEach(button => {
            button.addEventListener("click", () => {
                const tabId = button.getAttribute("data-tab");

                menuLinks.forEach(link => link.classList.remove("active"));
                button.classList.add("active");

                tabContents.forEach(tab => tab.classList.remove("active"));

                document.getElementById(tabId).classList.add("active");

                if (tabId === "about") {
                    statistics.style.display = "block";
                } else {
                    statistics.style.display = "none";
                }
            });
        });
    </script>
}
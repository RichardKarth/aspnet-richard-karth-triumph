@{
    ViewData["Title"] = "Set your password";
    ViewData["ShowHero"] = false;
}

<div class="auth-container">

    <div class="auth-text">
        <h1>Set Your Password</h1>
        <p>
            Set a strong password to protect your account. For security reasons, your password must be at least 8 characters long and include uppercase and lowercase letters, numbers, and special characters.
        </p>
    </div>

    <hr class="auth-divider">

    <form class="auth-form">
        <div class="form-group">
            <label>Email Address *</label>
            <input type="email" placeholder="Enter Email Address">
        </div>

        <div class="form-group">
            <label>Password </label>
            <input type="password" placeholder="Enter Password">
        </div>

        <button type="submit" class="auth-button">

            <span></span>

            <a class="continue-text" asp-action="submit" asp-controller="">
                Continue
            </a>

            <i class="fa-solid fa-chevron-right arrow"></i>

        </button>
    </form>

    <div class="terms-checkbox">
        <input class="checkbox" type="checkbox" id="terms">

        <label for="terms">
            Accept user terms and conditions
        </label>
    </div>

</div>

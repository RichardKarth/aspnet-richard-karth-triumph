@{
    ViewData["Title"] = "CustomerService";
    ViewData["ShowHero"] = false;
}
<div class="customer-service-container">

    <h1>Customer Service</h1>

    <div class="contact-us-card">
        <div class="contact-us-left-side">

            <img src="~/images/contact-us-image 1.png" alt="Profile Picture">

            <div class="contact-info-box">

                <div class="contact-item">
                    <div class="icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div class="text">
                        <h3>Phone Number</h3>
                        <p>+(46) 8 410 521 00</p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <div class="text">
                        <h3>Email Address</h3>
                        <p>info@corefitness.se</p>
                    </div>
                </div>

            </div>

        </div>
        <div class="contact-us-right-side">

            <h2>Contact Us Today</h2>
            <p>
                Ready to begin your fitness journey? Contact GymPro today and let our
                expert trainers guide you with the right program and support.
            </p>
            <form method="post" asp-action="" asp-asp-controller="CustomerService">
                <div class="customer-service-form-group">
                    <label>First Name</label>
                    <input type="text" placeholder="Enter First Name">
                </div>

                <div class="customer-service-form-group">
                    <label>Last Name</label>
                    <input type="text" placeholder="Enter Last Name">
                </div>

                <div class="customer-service-form-group">
                    <label>Email Address *</label>
                    <input type="text" placeholder="username@domain.com">
                </div>

                <div class="customer-service-form-group">
                    <label>Phone Number</label>
                    <input type="text" placeholder="Enter Phone Number">
                </div>

                <div class="customer-service-form-group message-group">
                 <label>Message *</label>
                    <textarea placeholder="Message..."></textarea>
                </div>
                
                <button type="submit" class="submit-btn-customer-service">
                    Submit Message 
                    <section class="fa-solid fa-chevron-right"></section>
                </button>
            </form>
        </div>
    </div>


</div>
@{
    ViewData["Title"] = "BecomeMember";
    ViewData["ShowHero"] = false;
}

<div class="auth-container">

    <div class="auth-text">
        <h1>Become a Member</h1>
        <p>
            Sign up to continue your fitness journey with full access to your customized program, training history, and progress tracking. Stay consistent, monitor your development, and keep moving forward with the structure and support built into your account.
        </p>
    </div>

    <hr class="auth-divider">

    <div class="auth-links">

        <a href="#" class="auth-link">
            <img src="~/images/google.png" alt="Google">
        </a>

        <a href="#" class="auth-link">
            <img src="~/images/facebook.png" alt="Facebook">
        </a>

        <a href="#" class="auth-link">
            <img src="~/images/github.png" alt="GitHub">
        </a>
    </div>
    <div class="continue-divider">
        <span></span>
        <p>OR CONTINUE WITH</p>
        <span></span>
    </div>
    <form class="auth-form" method="post" asp-controller="BecomeMember" asp-action="Index">

        <div class="form-group">
            <label>Email Address *</label>
            <input type="email" placeholder="Enter Email Address">
        </div>

        <button type="submit" class="auth-button">

            <span></span>

            <a class="continue-text" asp-action="Index" asp-controller="MyAccount">
                Continue
            </a>

            <i class="fa-solid fa-chevron-right arrow"></i>

        </button>
    </form>

    <div class="auth-container-p-tagg">
        <p>
            We will send a verification code to your email address.
        </p>
    </div>

</div>


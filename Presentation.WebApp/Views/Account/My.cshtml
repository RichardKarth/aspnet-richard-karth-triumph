@model MyAccountViewModel

@{
    ViewData["Title"] = "My Account";
    ViewData["ShowHero"] = false;
}

<div class="my-account-container">
    <h1>My Account</h1>
    <p>@ViewData["Debug"]</p>
    <div class="account-content">

        <div class="account-menu">
            <img src="~/images/trainer-1 1.png" alt="Profile Picture">

            <div class="menu-box">
                <div class="menu-header">Menu Options</div>

                <button class="menu-link active" data-tab="about">
                    About Me <i class="fa-solid fa-chevron-right"></i>
                </button>

                <button class="menu-link" data-tab="membership">
                    My Membership <i class="fa-solid fa-chevron-right"></i>
                </button>

                <button class="menu-link" data-tab="bookings">
                    My Bookings <i class="fa-solid fa-chevron-right"></i>
                </button>

                <button class="menu-link" data-tab="signout">
                    Sign Out <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>

            <p class="remove-info">If you like to cancel your account click below</p>
            <a class="remove-account" href="#">Remove Account</a>
        </div>

        <div class="right-column">

            <div class="account-form-card tab-content active" id="about">
                <h2>About Me</h2>

                <form method="post" asp-controller="Account" asp-action="My" novalidate>

                    @Html.AntiForgeryToken()

                    <div class="account-form-group">
                        <label asp-for ="AboutMeForm.FirstName"></label>
                        <input asp-for="AboutMeForm.FirstName">
                    </div>

                    <div class="account-form-group">
                        <label asp-for="AboutMeForm.LastName"></label>
                        <input asp-for="AboutMeForm.LastName">
                    </div>

                    <div class="account-form-group">
                        <label asp-for="AboutMeForm.Email"></label>
                        <input asp-for="AboutMeForm.Email" readonly>
                    </div>

                    <div class="account-form-group">
                        <label asp-for="AboutMeForm.PhoneNumber"></label>
                        <input asp-for="AboutMeForm.PhoneNumber">
                    </div>

                    <hr>

                    <div class="account-form-group file-group">
                        <label>Profile Image</label>

                        <div class="file-input">
                            <input asp-for="AboutMeForm.ProfileImageUrl" />
                            <button type="button">Browse</button>
                        </div>
                    </div>

                    <button type="submit" class="save-button">
                        Save
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </form>
            </div>

            <div class="account-form-card tab-content" id="membership">
                <h2>My Membership</h2>
                <div class="selected-membership">
                    <h3>Current Membership</h3>

                    @if (string.IsNullOrWhiteSpace(Model.SelectedMembershipId))
                    {
                        <p>No membership selected.</p>
                    }
                    else
                    {
                        <p>@Model.SelectedMembershipTitle</p>
                    }
                </div>

                <form method="post" asp-controller="Account" asp-action="UpdateMembership" class="membership-form">
                    @Html.AntiForgeryToken()

                    <div class="membership-box">
                        <h3>Choose your plan</h3>
                        <p>Select or change your current membership.</p>

                        <div class="membership-options">
                            <label class="membership-option">
                                <input type="radio" asp-for="SelectedMembershipId" value="" />
                                <span>
                                    <strong>No membership</strong>
                                    <small>Continue without a plan</small>
                                </span>
                            </label>

                            <label class="membership-option">
                                <input type="radio" asp-for="SelectedMembershipId" value="standard" />
                                <span>
                                    <strong>Standard Membership</strong>
                                    <small>Basic gym access</small>
                                </span>
                            </label>

                            <label class="membership-option">
                                <input type="radio" asp-for="SelectedMembershipId" value="premium" />
                                <span>
                                    <strong>Premium Membership</strong>
                                    <small>Full access + extra classes</small>
                                </span>
                            </label>
                        </div>

                        <button type="submit" class="save-button">
                            Save Membership
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </form>
            </div>

            <div class="account-form-card tab-content" id="bookings">
                <h2>My Bookings</h2>

                <div class="booking-list">
                    <div class="booking-item">
                        <h3>Strength Training</h3>
                        <p>Date: 2026-01-10</p>
                        <p>Time: 18:00</p>
                    </div>

                    <div class="booking-item">
                        <h3>Yoga Class</h3>
                        <p>Date: 2026-01-14</p>
                        <p>Time: 17:30</p>
                    </div>
                </div>
            </div>

            <div class="account-form-card tab-content" id="signout">
                <h2>Sign Out</h2>
                <p>Are you sure you want to sign out?</p>

                <button class="save-button" type="button">
                    Sign Out
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>

            <div class="statistics-card" id="statistics">
                <h2>My Statistics</h2>

                <div class="stats-box">
                    <div class="stat-row">
                        <div>
                            <span>Check-In (last 30 days)</span>
                            <strong>25</strong>
                        </div>
                        <div class="progress"><span style="width:95%"></span></div>
                    </div>

                    <div class="stat-row">
                        <div>
                            <span>Weight Goal</span>
                            <strong>50%</strong>
                        </div>
                        <div class="progress"><span style="width:50%"></span></div>
                    </div>

                    <div class="stat-row">
                        <div>
                            <span>Current BMI</span>
                            <strong>27</strong>
                        </div>
                        <div class="progress"><span style="width:65%"></span></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const menuLinks = document.querySelectorAll(".menu-link");
        const tabContents = document.querySelectorAll(".tab-content");
        const statistics = document.getElementById("statistics");

        menuLinks.forEach(button => {
            button.addEventListener("click", () => {
                const tabId = button.getAttribute("data-tab");

                menuLinks.forEach(link => link.classList.remove("active"));
                button.classList.add("active");

                tabContents.forEach(tab => tab.classList.remove("active"));

                document.getElementById(tabId).classList.add("active");

                if (tabId === "about") {
                    statistics.style.display = "block";
                } else {
                    statistics.style.display = "none";
                }
            });
        });
    </script>
}